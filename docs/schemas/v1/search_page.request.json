{
  "$defs": {
    "LanguageId": {
      "description": "Stable identifier of a language (`rust`, `typescript`, ...).",
      "type": "string"
    },
    "PageBudget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 16384,
          "format": "uint",
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer"
        },
        "max_items": {
          "default": 20,
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Query": {
      "properties": {
        "kind": {
          "description": "Tree-sitter node kind, e.g. `function_item`.",
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Restrict to one language; otherwise every registered language is searched."
        },
        "name": {
          "description": "Only declarations with exactly this name.",
          "type": [
            "string",
            "null"
          ]
        },
        "pattern": {
          "description": "ast-grep style pattern with meta-variables, e.g. `fn $NAME($$$ARGS) { $$$ }`.",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only declarations of this kind."
        }
      },
      "type": "object"
    },
    "RelPath": {
      "description": "A file's path inside the workspace, spelled the way the project does: `/`\non every platform.\n\nA workspace path is a project path — like a `mod` path or a\n`crate::a::b` address — not a path of the machine, so it carries its own\nspelling and is what goes on the wire, into a row, or into a diagnostic.\nIt reads as a [`Path`] (an OS path is made from one at the edge, where a\nfile is actually read), but it cannot spell a separator the host's way:\n`Display`, serde and the stored bytes are always `/`.",
      "type": "string"
    },
    "SearchScope": {
      "additionalProperties": false,
      "description": "Explicit file/directory prefixes and owning package names or IDs.\nAlternatives within each list are ORed; the two lists are intersected.",
      "properties": {
        "packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RelPath"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SymbolKind": {
      "description": "What a declaration declares, in vocabulary shared by every language.",
      "oneOf": [
        {
          "enum": [
            "type-parameter",
            "parameter",
            "function",
            "method",
            "struct",
            "class",
            "enum",
            "variant",
            "trait",
            "interface",
            "type-alias",
            "const",
            "static",
            "variable",
            "field",
            "module",
            "macro"
          ],
          "type": "string"
        },
        {
          "const": "impl",
          "description": "An `impl` block, named after the type it is for. Not a declaration a\npath can reach; it travels with its type when the type moves.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "urn:vvv:schema:1:search_page:request:bb482e11c4a4843863f0daf58acb5d46daa3bd22d398b0da18c822b9de6ac9c8",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "const": "search_page",
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/PageBudget",
      "default": {
        "max_bytes": 16384,
        "max_items": 20
      }
    },
    "query": {
      "$ref": "#/$defs/Query"
    },
    "scope": {
      "$ref": "#/$defs/SearchScope",
      "default": {
        "packages": [],
        "paths": []
      }
    }
  },
  "required": [
    "command",
    "query"
  ],
  "title": "search_page request",
  "type": "object"
}
