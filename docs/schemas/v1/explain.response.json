{
  "$defs": {
    "Address": {
      "description": "A position in a language's namespace: the package it belongs to and the\npath within it — `fff :: [grep, types]` for a Rust module, path\ncomponents for a TypeScript file. Prefix relations, which are what a move\ncares about, never hold across packages.",
      "properties": {
        "package": {
          "$ref": "#/$defs/PackageId"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/Name"
          },
          "type": "array"
        }
      },
      "required": [
        "package",
        "path"
      ],
      "type": "object"
    },
    "ContentId": {
      "description": "Digest of the complete UTF-8 source text, independent of its path.",
      "type": "string"
    },
    "ContinuationRecovery": {
      "description": "A recovery action clients can branch on without parsing the error message.",
      "enum": [
        "restart_query",
        "correct_cursor",
        "increase_budget_or_narrow_query",
        "narrow_query"
      ],
      "type": "string"
    },
    "Dep": {
      "description": "One import statement in the file and, when the layout can follow it,\nwhere it leads.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the path spells, as the layout places it."
        },
        "alias": {
          "anyOf": [
            {
              "$ref": "#/$defs/Name"
            },
            {
              "type": "null"
            }
          ],
          "description": "The name the statement binds instead of the path's last segment:\n`Cfg` in `use a::Config as Cfg`."
        },
        "declares": {
          "default": true,
          "description": "Part of an import statement (`use`, `import`), so it brings its last\nsegment into the file's scope. A qualified path in an expression\n(`fff::GrepMatch` in a type position) is a reference to rewrite on a\nmove, but declares nothing.",
          "type": "boolean"
        },
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file declaring what the import reaches — the origin's when known."
        },
        "glob": {
          "description": "`use a::b::*`: every name under the path is brought into scope.",
          "type": "boolean"
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImportGroup"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present when the path is an entry of a grouped import such as\n`use a::{b, c::d}`; replacing `span` alone can then only express\npaths that stay under the group's prefix."
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "The declaration the address reaches through re-exports, when that is\nsomewhere else: `vvv_core::text::span::Span` for `use vvv_core::Span`."
        },
        "path": {
          "$ref": "#/$defs/ModulePath",
          "description": "The full path as written (`crate::a::b`, `../x/y`), parsed by the\ngrammar's [`PathSyntax`]. For a grouped entry this includes the\ngroup's prefix."
        },
        "reexport": {
          "description": "A `pub use`, an `export … from`: the name it brings in is offered on\nagain under this file's address, so a path to it here reaches the\noriginal declaration.",
          "type": "boolean"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "start": {
          "$ref": "#/$defs/Position",
          "description": "Where the import starts, as a line and column."
        }
      },
      "required": [
        "span",
        "path",
        "start"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "The kind of failure, stable across releases; the message is not.",
      "oneOf": [
        {
          "enum": [
            "cursor_expired",
            "invalid_cursor",
            "retention_limit",
            "output_limit"
          ],
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The caller cancelled the operation.",
          "type": "string"
        },
        {
          "const": "incomplete",
          "description": "Resolution stopped before a complete answer was available.",
          "type": "string"
        },
        {
          "const": "bad_request",
          "description": "The request could not be read: not JSON, or not a known command.",
          "type": "string"
        },
        {
          "const": "bad_query",
          "description": "A query with none of pattern, kind, symbol, name.",
          "type": "string"
        },
        {
          "const": "bad_pattern",
          "description": "A pattern or node kind the language's grammar rejects.",
          "type": "string"
        },
        {
          "const": "bad_selection",
          "description": "A selection naming rows or ids the search did not find.",
          "type": "string"
        },
        {
          "const": "bad_template",
          "description": "A template naming a capture the match does not have.",
          "type": "string"
        },
        {
          "const": "no_such_symbol",
          "description": "No declaration by that name (and kind).",
          "type": "string"
        },
        {
          "const": "ambiguous_symbol",
          "description": "Several declarations share the name; `declared_in` picks one.",
          "type": "string"
        },
        {
          "const": "no_language",
          "description": "No registered language claims the file.",
          "type": "string"
        },
        {
          "const": "no_layout",
          "description": "The language has no layout: paths cannot be followed, files not moved.",
          "type": "string"
        },
        {
          "const": "no_such_position",
          "description": "A position past the end of the file.",
          "type": "string"
        },
        {
          "const": "exists",
          "description": "The destination already exists.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "A file, or the file declaring a name, could not be found.",
          "type": "string"
        },
        {
          "const": "unmovable",
          "description": "The layout refuses the move: a root, across packages, into itself.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "Two edits of one plan overlap, or a file is moved twice.",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "A file changed since the plan (or the apply to undo) was made.",
          "type": "string"
        },
        {
          "const": "no_history",
          "description": "Nothing to undo, or a history file that cannot be read.",
          "type": "string"
        },
        {
          "const": "io",
          "description": "Reading or writing the tree failed.",
          "type": "string"
        },
        {
          "const": "recovery_failed",
          "description": "Recovery could not restore or verify every attempted effect.",
          "type": "string"
        }
      ]
    },
    "Explanation": {
      "description": "`explain <path>:<line>:<column>`: what is at a position.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "declared": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where that declaration's name starts, and the source line holding it."
        },
        "import": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dep"
            },
            {
              "type": "null"
            }
          ],
          "description": "The import statement at the position, when it is inside one: what\nit spells and where that really comes from."
        },
        "importers": {
          "description": "Files whose imports resolve to the declaration, to any address a\nre-export offers it at, or to its module when the declaration itself\nis not addressable.",
          "items": {
            "$ref": "#/$defs/RelPath"
          },
          "type": "array"
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        },
        "module": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file's module address, and the declaration's when a path reaches it."
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "reach": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reach"
            },
            {
              "type": "null"
            }
          ]
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/Symbol"
            },
            {
              "type": "null"
            }
          ],
          "description": "The innermost declaration whose extent contains the position."
        },
        "via": {
          "description": "Every other address a re-export chain offers the declaration at.",
          "items": {
            "$ref": "#/$defs/Address"
          },
          "type": "array"
        }
      },
      "required": [
        "path",
        "position",
        "importers"
      ],
      "type": "object"
    },
    "Failure": {
      "description": "A failed request, as the wire carries it.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContinuationRecovery"
            },
            {
              "type": "null"
            }
          ]
        },
        "hint": {
          "description": "What to try instead, when there is something.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "output_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recovery"
            },
            {
              "type": "null"
            }
          ],
          "description": "Effects that could not be restored after a failed mutation."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ImportGroup": {
      "description": "Where a grouped entry sits, so a surgery can rewrite it in place or move\nit out of the group.",
      "properties": {
        "item": {
          "$ref": "#/$defs/Span",
          "description": "The whole entry, alias or nested list included (`parse::Config as Cfg`)."
        },
        "items": {
          "description": "How many entries that list has.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "list": {
          "$ref": "#/$defs/Span",
          "description": "The innermost list the entry belongs to, braces included."
        },
        "prefix": {
          "$ref": "#/$defs/ModulePath",
          "description": "Combined prefix of the enclosing groups (`crate::util`)."
        },
        "statement": {
          "$ref": "#/$defs/Span",
          "description": "The enclosing statement (`pub use crate::util::{…};`)."
        },
        "top_level": {
          "description": "Whether `list` is the statement's own list rather than a nested one.",
          "type": "boolean"
        }
      },
      "required": [
        "prefix",
        "item",
        "list",
        "items",
        "statement",
        "top_level"
      ],
      "type": "object"
    },
    "Modifier": {
      "description": "A visibility modifier as it appears in the source.",
      "properties": {
        "span": {
          "$ref": "#/$defs/Span"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "span",
        "text"
      ],
      "type": "object"
    },
    "ModulePath": {
      "description": "A path as spelled in source: its head and its segments, with the syntax\nthat spells it. Serialises as the text, so the wire is what the user\nwrote.",
      "type": "string"
    },
    "Name": {
      "description": "One identifier: a module, a declaration, a file stem. Compared by text.",
      "type": "string"
    },
    "OutputLimit": {
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "required_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_bytes",
        "required_bytes"
      ],
      "type": "object"
    },
    "PackageId": {
      "description": "The name a package goes by in paths: a Rust crate's lib name (`fff`, not\n`fff-search`), a TypeScript package's name. The layout decides the spelling.",
      "type": "string"
    },
    "Position": {
      "description": "Zero-based line and character column. Columns count `char`s, not bytes,\nso they are safe to show to humans and editors.",
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "type": "object"
    },
    "Reach": {
      "description": "The set of modules that may name a declaration: a kind applied to the\ndeclaring module's address. Never declared, always computed.",
      "oneOf": [
        {
          "enum": [
            "everyone"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "within": {
              "$ref": "#/$defs/Address"
            }
          },
          "required": [
            "within"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "package": {
              "$ref": "#/$defs/PackageId"
            }
          },
          "required": [
            "package"
          ],
          "type": "object"
        }
      ]
    },
    "Recovery": {
      "description": "A recovery result; unknown states are separate from confirmed residual effects.",
      "properties": {
        "cause": {
          "$ref": "#/$defs/Failure"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/RecoveryIssue"
          },
          "type": "array"
        },
        "remaining": {
          "items": {
            "$ref": "#/$defs/RecoveryEffect"
          },
          "type": "array"
        },
        "unverified": {
          "items": {
            "$ref": "#/$defs/RecoveryUnverified"
          },
          "type": "array"
        }
      },
      "required": [
        "cause",
        "failures",
        "remaining",
        "unverified"
      ],
      "type": "object"
    },
    "RecoveryEffect": {
      "properties": {
        "expected": {
          "$ref": "#/$defs/RecoveryState"
        },
        "observed": {
          "$ref": "#/$defs/RecoveryState"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path",
        "expected",
        "observed"
      ],
      "type": "object"
    },
    "RecoveryIssue": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/RecoveryOperation"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "operation",
        "path",
        "code",
        "message"
      ],
      "type": "object"
    },
    "RecoveryOperation": {
      "enum": [
        "restore_file",
        "restore_move",
        "restore_directory",
        "remove_file",
        "remove_directory"
      ],
      "type": "string"
    },
    "RecoveryState": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "fingerprint": {
              "type": "string"
            },
            "kind": {
              "const": "file",
              "type": "string"
            },
            "spelling": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RelPath"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "directory",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "other",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RecoveryUnverified": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "expected": {
          "$ref": "#/$defs/RecoveryState"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path",
        "expected",
        "code",
        "message"
      ],
      "type": "object"
    },
    "RelPath": {
      "description": "A file's path inside the workspace, spelled the way the project does: `/`\non every platform.\n\nA workspace path is a project path — like a `mod` path or a\n`crate::a::b` address — not a path of the machine, so it carries its own\nspelling and is what goes on the wire, into a row, or into a diagnostic.\nIt reads as a [`Path`] (an OS path is made from one at the edge, where a\nfile is actually read), but it cannot spell a separator the host's way:\n`Display`, serde and the stored bytes are always `/`.",
      "type": "string"
    },
    "SourceAnchor": {
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentId"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "path",
        "content",
        "span"
      ],
      "type": "object"
    },
    "Span": {
      "description": "Half-open byte range `[start, end)` inside a single file.",
      "properties": {
        "end": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Symbol": {
      "description": "A declaration found in one file.",
      "properties": {
        "extent": {
          "$ref": "#/$defs/Span",
          "description": "The declaration with what belongs to it in the text: leading\nattributes and doc comments, an enclosing `export`. What moving the\ndeclaration cuts; what an outline shows."
        },
        "kind": {
          "$ref": "#/$defs/SymbolKind"
        },
        "name": {
          "type": "string"
        },
        "name_span": {
          "$ref": "#/$defs/Span",
          "description": "The identifier token itself: what a rename replaces."
        },
        "span": {
          "$ref": "#/$defs/Span",
          "description": "The declaration node."
        },
        "visibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Modifier"
            },
            {
              "type": "null"
            }
          ],
          "description": "The visibility as written (`pub(crate)`, `export`); `None` when the\ndeclaration has no modifier. What it means is the language's\n[`Semantics`](crate::Semantics)."
        }
      },
      "required": [
        "kind",
        "name",
        "name_span",
        "span",
        "extent"
      ],
      "type": "object"
    },
    "SymbolKind": {
      "description": "What a declaration declares, in vocabulary shared by every language.",
      "oneOf": [
        {
          "enum": [
            "type-parameter",
            "parameter",
            "function",
            "method",
            "struct",
            "class",
            "enum",
            "variant",
            "trait",
            "interface",
            "type-alias",
            "const",
            "static",
            "variable",
            "field",
            "module",
            "macro"
          ],
          "type": "string"
        },
        {
          "const": "impl",
          "description": "An `impl` block, named after the type it is for. Not a declaration a\npath can reach; it travels with its type when the type moves.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "urn:vvv:schema:1:explain:response:089cf5d9c2d3f0ac8243331d47978a8d842573ac279a0b99724411cec7cac153",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Top-level envelope of every `--json` response.",
  "oneOf": [
    {
      "properties": {
        "result": {
          "$ref": "#/$defs/Explanation"
        },
        "schema": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "ok",
          "type": "string"
        }
      },
      "required": [
        "status",
        "schema",
        "result"
      ],
      "type": "object"
    },
    {
      "description": "A failed request, as the wire carries it.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContinuationRecovery"
            },
            {
              "type": "null"
            }
          ]
        },
        "hint": {
          "description": "What to try instead, when there is something.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "output_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recovery"
            },
            {
              "type": "null"
            }
          ],
          "description": "Effects that could not be restored after a failed mutation."
        },
        "schema": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "error",
          "type": "string"
        }
      },
      "required": [
        "status",
        "schema",
        "code",
        "message"
      ],
      "type": "object"
    }
  ],
  "title": "explain response"
}
