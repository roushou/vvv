{
  "$defs": {
    "PageBudget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 16384,
          "format": "uint",
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer"
        },
        "max_items": {
          "default": 20,
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "PrepareMoveIntent": {
      "additionalProperties": false,
      "description": "Workspace-relative source and destination for a retained file/directory move.",
      "properties": {
        "from": {
          "$ref": "#/$defs/RelPath"
        },
        "to": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "RelPath": {
      "description": "A file's path inside the workspace, spelled the way the project does: `/`\non every platform.\n\nA workspace path is a project path — like a `mod` path or a\n`crate::a::b` address — not a path of the machine, so it carries its own\nspelling and is what goes on the wire, into a row, or into a diagnostic.\nIt reads as a [`Path`] (an OS path is made from one at the edge, where a\nfile is actually read), but it cannot spell a separator the host's way:\n`Display`, serde and the stored bytes are always `/`.",
      "type": "string"
    }
  },
  "$id": "urn:vvv:schema:1:prepare_move:request:bf9da75723cc8cac10220993b838ceee9500d14ff73e7a38ba781c8f0f1c5ff3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "const": "prepare_move",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/PrepareMoveIntent"
    },
    "max_bytes": {
      "default": 16384,
      "format": "uint",
      "maximum": 1048576,
      "minimum": 1024,
      "type": "integer"
    },
    "page": {
      "anyOf": [
