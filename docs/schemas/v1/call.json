{
  "$defs": {
    "BatchIntent": {
      "description": "Several intents planned in sequence, each against the state the previous\none leaves, and applied as one.",
      "properties": {
        "intents": {
          "items": {
            "$ref": "#/$defs/Intent"
          },
          "type": "array"
        }
      },
      "required": [
        "intents"
      ],
      "type": "object"
    },
    "CheckCommand": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "A caller-defined label, such as formatting, compilation, or unit tests.",
          "type": "string"
        },
        "program": {
          "description": "Executed directly, without implicit shell parsing.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "program"
      ],
      "type": "object"
    },
    "Command": {
      "enum": [
        "discard_plan",
        "apply_plan",
        "validate_plan",
        "inspect_plan",
        "prepare_rename",
        "prepare_rewrite",
        "prepare_move",
        "prepare_move_symbol",
        "symbol_move_candidates",
        "review_plan",
        "schema",
        "search_page",
        "context_page",
        "continue",
        "expand",
        "discover",
        "context",
        "navigate",
        "relationships",
        "resolve",
        "search",
        "outline",
        "references",
        "where",
        "deps",
        "explain",
        "surface",
        "impact",
        "dead",
        "imports",
        "file",
        "rewrite",
        "rename",
        "move",
        "move_symbol",
        "batch",
        "history",
        "undo"
      ],
      "type": "string"
    },
    "ContentId": {
      "description": "Digest of complete file contents, independent of their path.",
      "type": "string"
    },
    "ContextBudget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 16384,
          "description": "Maximum compact JSON bytes in the result, excluding the response envelope.",
          "format": "uint",
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer"
        },
        "max_files": {
          "default": 64,
          "description": "Maximum source files examined for incoming written-name and named-alias references.",
          "format": "uint",
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "max_items": {
          "default": 12,
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "max_lookups": {
          "default": 64,
          "format": "uint",
          "maximum": 512,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ContextDetail": {
      "description": "Source detail requested for every context item. Bodies remain the default.",
      "enum": [
        "body",
        "signature"
      ],
      "type": "string"
    },
    "ContextQuery": {
      "properties": {
        "budget": {
          "$ref": "#/$defs/ContextBudget",
          "default": {
            "max_bytes": 16384,
            "max_files": 64,
            "max_items": 12,
            "max_lookups": 64
          }
        },
        "detail": {
          "$ref": "#/$defs/ContextDetail",
          "default": "body"
        },
        "include_enclosing": {
          "default": false,
          "description": "Include the enclosing declaration at the requested detail as a separate item.",
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/NavigationOrigin"
        },
        "references": {
          "default": false,
          "description": "Include incoming written-name and named-import-alias references, validated by navigation.",
          "type": "boolean"
        },
        "selection": {
          "$ref": "#/$defs/Selection",
          "default": "all"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "DeadQuery": {
      "description": "`vvv dead`: declarations nothing in the workspace refers to.",
      "properties": {
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "DepsQuery": {
      "description": "`vvv deps <path>`: what a file imports and who imports it.",
      "properties": {
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "DiscoveryQuery": {
      "type": "object"
    },
    "ExplainQuery": {
      "description": "`vvv explain <path>:<line>:<col>`: what is at a position.",
      "properties": {
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "position": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "path",
        "position"
      ],
      "type": "object"
    },
    "FileQuery": {
      "description": "One file as it is now, with its syntax colouring: what a picker shows.",
      "properties": {
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "ImpactQuery": {
      "description": "`vvv impact <name>`: who would feel a change to a declaration.",
      "properties": {
        "declared_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file declaring the symbol meant, when several share the name."
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ImportsQuery": {
      "description": "`vvv imports [path]`: import statements worth a look.",
      "properties": {
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Intent": {
      "description": "Any mutating request, as one value: what history records, what a summary\nrenders, what a remote client sends.",
      "oneOf": [
        {
          "$ref": "#/$defs/RewriteIntent",
          "properties": {
            "command": {
              "const": "rewrite",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/RenameIntent",
          "properties": {
            "command": {
              "const": "rename",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/MoveIntent",
          "properties": {
            "command": {
              "const": "move",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/MoveSymbolIntent",
          "properties": {
            "command": {
              "const": "move_symbol",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/BatchIntent",
          "description": "Several intents planned in sequence, each against the state the\nprevious one leaves, and applied as one.",
          "properties": {
            "command": {
              "const": "batch",
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        }
      ]
    },
    "LanguageId": {
      "description": "Stable identifier of a language (`rust`, `typescript`, ...).",
      "type": "string"
    },
    "MatchId": {
      "description": "Content-derived identifier: the same file, range and text yield the same id\nacross runs, so a selection made from one `search` can drive a later command.",
      "type": "string"
    },
    "MoveIntent": {
      "description": "Move a file and make every reference to it follow.",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "MoveSymbolIntent": {
      "description": "Move one declaration — with what belongs to it in the text, and for Rust\nits `impl` blocks — from the file declaring it to another file of the\nsame language, and make every reference follow.",
      "properties": {
        "expected_content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "description": "The file declaring it.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "to": {
          "description": "The file to declare it in; it must exist.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "from",
        "to"
      ],
      "type": "object"
    },
    "NavigationOrigin": {
      "oneOf": [
        {
          "properties": {
            "expected_content": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ContentId"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "kind": {
              "const": "position",
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/RelPath"
            },
            "position": {
              "$ref": "#/$defs/Position"
            }
          },
          "required": [
            "kind",
            "path",
            "position"
          ],
          "type": "object"
        },
        {
          "properties": {
            "anchor": {
              "$ref": "#/$defs/SourceAnchor"
            },
            "kind": {
              "const": "occurrence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "anchor"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "symbol",
              "type": "string"
            },
            "symbol": {
              "$ref": "#/$defs/SymbolRef"
            }
          },
          "required": [
            "kind",
            "symbol"
          ],
          "type": "object"
        }
      ]
    },
    "NavigationQuery": {
      "properties": {
        "origin": {
          "$ref": "#/$defs/NavigationOrigin"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        }
      },
      "required": [
        "origin"
      ],
      "type": "object"
    },
    "OutlineQuery": {
      "description": "`vvv outline <path>`: what a file declares.",
      "properties": {
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "PageBudget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 16384,
          "format": "uint",
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer"
        },
        "max_items": {
          "default": 20,
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "PlanId": {
      "description": "Opaque handle scoped to an engine session, not a serializable edit plan.",
      "type": "string"
    },
    "PlanReviewCursor": {
      "description": "A plan-store cursor. It cannot be used with source-query continue or expand.",
      "type": "string"
    },
    "Position": {
      "description": "Zero-based line and character column. Columns count `char`s, not bytes,\nso they are safe to show to humans and editors.",
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "type": "object"
    },
    "PrepareMoveIntent": {
      "additionalProperties": false,
      "description": "Workspace-relative source and destination for a retained file/directory move.",
      "properties": {
        "from": {
          "$ref": "#/$defs/RelPath"
        },
        "to": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "PrepareMoveSymbolIntent": {
      "additionalProperties": false,
      "description": "Workspace-relative selected declaration move between existing files.",
      "properties": {
        "expected_content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "$ref": "#/$defs/RelPath"
        },
        "name": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "to": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "name",
        "from",
        "to"
      ],
      "type": "object"
    },
    "Query": {
      "properties": {
        "kind": {
          "description": "Tree-sitter node kind, e.g. `function_item`.",
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Restrict to one language; otherwise every registered language is searched."
        },
        "name": {
          "description": "Only declarations with exactly this name.",
          "type": [
            "string",
            "null"
          ]
        },
        "pattern": {
          "description": "ast-grep style pattern with meta-variables, e.g. `fn $NAME($$$ARGS) { $$$ }`.",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only declarations of this kind."
        }
      },
      "type": "object"
    },
    "ReferencesQuery": {
      "description": "The declaration(s) called `name`, and every identifier that spells it,\neach judged against the declaration meant. What `rename` gathers before\nit plans, and what `references` answers on its own.",
      "properties": {
        "declared_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file declaring the symbol meant, when several share the name."
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageId"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolKind"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "RelPath": {
      "description": "A file's path inside the workspace, spelled the way the project does: `/`\non every platform.\n\nA workspace path is a project path — like a `mod` path or a\n`crate::a::b` address — not a path of the machine, so it carries its own\nspelling and is what goes on the wire, into a row, or into a diagnostic.\nIt reads as a [`Path`] (an OS path is made from one at the edge, where a\nfile is actually read), but it cannot spell a separator the host's way:\n`Display`, serde and the stored bytes are always `/`.",
      "type": "string"
    },
    "RelationshipBudget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 16384,
          "format": "uint",
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer"
        },
        "max_files": {
          "default": 128,
          "format": "uint",
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        },
        "max_items": {
          "default": 64,
          "format": "uint",
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "max_lookups": {
          "default": 1024,
          "format": "uint",
          "maximum": 16384,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "RelationshipKind": {
      "enum": [
        "callers",
        "callees",
        "references"
      ],
      "type": "string"
    },
    "RelationshipsQuery": {
      "properties": {
        "budget": {
          "$ref": "#/$defs/RelationshipBudget",
          "default": {
            "max_bytes": 16384,
            "max_files": 128,
            "max_items": 64,
            "max_lookups": 1024
          }
        },
        "kind": {
          "$ref": "#/$defs/RelationshipKind"
        },
        "origin": {
          "$ref": "#/$defs/NavigationOrigin"
        },
        "scope": {
          "$ref": "#/$defs/SearchScope",
          "default": {
            "packages": [],
            "paths": []
          }
        },
        "selection": {
          "$ref": "#/$defs/Selection",
          "default": "all"
        }
      },
      "required": [
        "origin",
        "kind"
      ],
      "type": "object"
    },
    "RenameIntent": {
      "description": "Rename the declaration(s) called `name` and every identifier that spells it.\n\nResolution is syntactic: every occurrence of the identifier in files of\nthe declaring language is an occurrence. The `selection` is how a human or\nagent excludes the ones that are not the same symbol.",
      "properties": {
        "declared_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file declaring the symbol meant, when several share the name."
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageId"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "to"
      ],
      "type": "object"
    },
    "ResolutionQuery": {
      "$ref": "#/$defs/NavigationQuery",
      "description": "Compact resolution with the same origin and selection semantics as navigation."
    },
    "RewriteIntent": {
      "description": "Replace every selected match of `query` with `template`.",
      "properties": {
        "query": {
          "$ref": "#/$defs/Query"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "template": {
          "$ref": "#/$defs/Template"
        }
      },
      "required": [
        "query",
        "template"
      ],
      "type": "object"
    },
    "SchemaContract": {
      "enum": [
        "arguments",
        "request",
        "result",
        "response",
        "call",
        "reply"
      ],
      "type": "string"
    },
    "SchemaQuery": {
      "description": "A command contract, or an aggregate session contract without `for_command`.",
      "properties": {
        "contract": {
          "$ref": "#/$defs/SchemaContract"
        },
        "for_command": {
          "anyOf": [
            {
              "$ref": "#/$defs/Command"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract"
      ],
      "type": "object"
    },
    "SearchQuery": {
      "description": "A structural or symbolic search with a typed engine answer.\nPlugin predicates remain separate from engine-owned workspace filters.",
      "properties": {
        "kind": {
          "description": "Tree-sitter node kind, e.g. `function_item`.",
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Restrict to one language; otherwise every registered language is searched."
        },
        "name": {
          "description": "Only declarations with exactly this name.",
          "type": [
            "string",
            "null"
          ]
        },
        "pattern": {
          "description": "ast-grep style pattern with meta-variables, e.g. `fn $NAME($$$ARGS) { $$$ }`.",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/SearchScope"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only declarations of this kind."
        }
      },
      "type": "object"
    },
    "SearchScope": {
      "additionalProperties": false,
      "description": "Explicit file/directory prefixes and owning package names or IDs.\nAlternatives within each list are ORed; the two lists are intersected.",
      "properties": {
        "packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RelPath"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Selection": {
      "description": "Which matches of a search a later command acts on.\n\nIds are content-derived, so a selection made from `vvv search` can be\nhanded to `vvv rewrite` in a separate process. Ordinals are the 1-based\npositions in the same search's result order, which is what human output\nnumbers rows with. Either kind that no longer resolves means the files\nchanged in between; the selection is then refused rather than silently\nnarrowed.",
      "oneOf": [
        {
          "enum": [
            "all"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ids": {
              "items": {
                "$ref": "#/$defs/MatchId"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "ids"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ordinals": {
              "items": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "ordinals"
          ],
          "type": "object"
        }
      ]
    },
    "SourceAnchor": {
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentId"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "path",
        "content",
        "span"
      ],
      "type": "object"
    },
    "Span": {
      "description": "Half-open byte range `[start, end)` inside a single file.",
      "properties": {
        "end": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint",
          "minimum": 0,
