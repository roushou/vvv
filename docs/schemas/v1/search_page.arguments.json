{
  "$defs": {
    "LanguageId": {
      "description": "Stable identifier of a language (`rust`, `typescript`, ...).",
      "type": "string"
    },
    "PageBudget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 16384,
          "format": "uint",
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer"
        },
        "max_items": {
          "default": 20,
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Query": {
      "properties": {
        "kind": {
          "description": "Tree-sitter node kind, e.g. `function_item`.",
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Restrict to one language; otherwise every registered language is searched."
        },
        "name": {
          "description": "Only declarations with exactly this name.",
          "type": [
            "string",
            "null"
          ]
        },
        "pattern": {
          "description": "ast-grep style pattern with meta-variables, e.g. `fn $NAME($$$ARGS) { $$$ }`.",
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only declarations of this kind."
        }
      },
      "type": "object"
    },
    "SymbolKind": {
      "description": "What a declaration declares, in vocabulary shared by every language.",
      "oneOf": [
        {
          "enum": [
            "type-parameter",
            "parameter",
            "function",
            "method",
            "struct",
            "class",
            "enum",
            "variant",
            "trait",
            "interface",
            "type-alias",
            "const",
            "static",
            "variable",
            "field",
            "module",
            "macro"
          ],
          "type": "string"
        },
        {
          "const": "impl",
          "description": "An `impl` block, named after the type it is for. Not a declaration a\npath can reach; it travels with its type when the type moves.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "urn:vvv:schema:1:search_page:arguments:9dca67c571e64039de4ff4ef3a20e872f074d25a51d93cc4299b0c5afb7986f1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "page": {
      "$ref": "#/$defs/PageBudget",
      "default": {
        "max_bytes": 16384,
        "max_items": 20
      }
    },
    "query": {
      "$ref": "#/$defs/Query"
    }
  },
  "required": [
    "query"
  ],
  "title": "search_page arguments",
  "type": "object"
}
