{
  "$defs": {
    "Address": {
      "description": "A position in a language's namespace: the package it belongs to and the\npath within it — `fff :: [grep, types]` for a Rust module, path\ncomponents for a TypeScript file. Prefix relations, which are what a move\ncares about, never hold across packages.",
      "properties": {
        "package": {
          "$ref": "#/$defs/PackageId"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/Name"
          },
          "type": "array"
        }
      },
      "required": [
        "package",
        "path"
      ],
      "type": "object"
    },
    "Capture": {
      "description": "One meta-variable binding.",
      "properties": {
        "span": {
          "$ref": "#/$defs/Span"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "span",
        "text"
      ],
      "type": "object"
    },
    "CaptureValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/Capture"
        },
        {
          "items": {
            "$ref": "#/$defs/Capture"
          },
          "type": "array"
        }
      ],
      "description": "`$A` binds one node; `$$$A` binds a sequence."
    },
    "ContentId": {
      "description": "Digest of complete file contents, independent of their path.",
      "type": "string"
    },
    "ContinuationRecovery": {
      "description": "A recovery action clients can branch on without parsing the error message.",
      "enum": [
        "restart_query",
        "correct_cursor",
        "increase_budget_or_narrow_query",
        "narrow_query"
      ],
      "type": "string"
    },
    "Dep": {
      "description": "One import statement in the file and, when the layout can follow it,\nwhere it leads.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the path spells, as the layout places it."
        },
        "alias": {
          "anyOf": [
            {
              "$ref": "#/$defs/Name"
            },
            {
              "type": "null"
            }
          ],
          "description": "The name the statement binds instead of the path's last segment:\n`Cfg` in `use a::Config as Cfg`."
        },
        "declares": {
          "default": true,
          "description": "Part of an import statement (`use`, `import`), so it brings its last\nsegment into the file's scope. A qualified path in an expression\n(`fff::GrepMatch` in a type position) is a reference to rewrite on a\nmove, but declares nothing.",
          "type": "boolean"
        },
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file declaring what the import reaches — the origin's when known."
        },
        "glob": {
          "description": "`use a::b::*`: every name under the path is brought into scope.",
          "type": "boolean"
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImportGroup"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present when the path is an entry of a grouped import such as\n`use a::{b, c::d}`; replacing `span` alone can then only express\npaths that stay under the group's prefix."
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "The declaration the address reaches through re-exports, when that is\nsomewhere else: `vvv_core::text::span::Span` for `use vvv_core::Span`."
        },
        "path": {
          "$ref": "#/$defs/ModulePath",
          "description": "The full path as written (`crate::a::b`, `../x/y`), parsed by the\ngrammar's [`PathSyntax`]. For a grouped entry this includes the\ngroup's prefix."
        },
        "reexport": {
          "description": "A `pub use`, an `export … from`: the name it brings in is offered on\nagain under this file's address, so a path to it here reaches the\noriginal declaration.",
          "type": "boolean"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "start": {
          "$ref": "#/$defs/Position",
          "description": "Where the import starts, as a line and column."
        }
      },
      "required": [
        "span",
        "path",
        "start"
      ],
      "type": "object"
    },
    "Deps": {
      "description": "`deps <path>`: what a file imports and who imports it.",
      "properties": {
        "importers": {
          "items": {
            "$ref": "#/$defs/Importer"
          },
          "type": "array"
        },
        "imports": {
          "items": {
            "$ref": "#/$defs/Dep"
          },
          "type": "array"
        },
        "module": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file's own module address, when the language has one."
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/Skipped"
          },
          "type": "array"
        }
      },
      "required": [
        "path",
        "imports",
        "importers"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "The kind of failure, stable across releases; the message is not.",
      "oneOf": [
        {
          "enum": [
            "invalid_plan",
            "plan_expired",
            "plan_consumed",
            "cursor_expired",
            "invalid_cursor",
            "retention_limit",
            "output_limit"
          ],
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The caller cancelled the operation.",
          "type": "string"
        },
        {
          "const": "incomplete",
          "description": "Resolution stopped before a complete answer was available.",
          "type": "string"
        },
        {
          "const": "bad_request",
          "description": "The request could not be read: not JSON, or not a known command.",
          "type": "string"
        },
        {
          "const": "bad_query",
          "description": "A query with none of pattern, kind, symbol, name.",
          "type": "string"
        },
        {
          "const": "bad_pattern",
          "description": "A pattern or node kind the language's grammar rejects.",
          "type": "string"
        },
        {
          "const": "bad_selection",
          "description": "A selection naming rows or ids the search did not find.",
          "type": "string"
        },
        {
          "const": "bad_template",
          "description": "A template naming a capture the match does not have.",
          "type": "string"
        },
        {
          "const": "no_such_symbol",
          "description": "No declaration by that name (and kind).",
          "type": "string"
        },
        {
          "const": "ambiguous_symbol",
          "description": "Several declarations share the name; `declared_in` picks one.",
          "type": "string"
        },
        {
          "const": "no_language",
          "description": "No registered language claims the file.",
          "type": "string"
        },
        {
          "const": "no_layout",
          "description": "The language has no layout: paths cannot be followed, files not moved.",
          "type": "string"
        },
        {
          "const": "no_such_position",
          "description": "A position past the end of the file.",
          "type": "string"
        },
        {
          "const": "exists",
          "description": "The destination already exists.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "A file, or the file declaring a name, could not be found.",
          "type": "string"
        },
        {
          "const": "unmovable",
          "description": "The layout refuses the move: a root, across packages, into itself.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "Two edits of one plan overlap, or a file is moved twice.",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "A file changed since the plan (or the apply to undo) was made.",
          "type": "string"
        },
        {
          "const": "no_history",
          "description": "Nothing to undo, or a history file that cannot be read.",
          "type": "string"
        },
        {
          "const": "io",
          "description": "Reading or writing the tree failed.",
          "type": "string"
        },
        {
          "const": "recovery_failed",
          "description": "Recovery could not restore or verify every attempted effect.",
          "type": "string"
        }
      ]
    },
    "Failure": {
      "description": "A failed request, as the wire carries it.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContinuationRecovery"
            },
            {
              "type": "null"
            }
          ]
        },
        "hint": {
          "description": "What to try instead, when there is something.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "output_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recovery"
            },
            {
              "type": "null"
            }
          ],
          "description": "Effects that could not be restored after a failed mutation."
        },
        "symbol_move_candidates": {
          "items": {
            "$ref": "#/$defs/SymbolMoveCandidate"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "symbol_move_unsupported": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolMoveUnsupported"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ImportGroup": {
      "description": "Where a grouped entry sits, so a surgery can rewrite it in place or move\nit out of the group.",
      "properties": {
        "item": {
          "$ref": "#/$defs/Span",
          "description": "The whole entry, alias or nested list included (`parse::Config as Cfg`)."
        },
        "items": {
          "description": "How many entries that list has.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "list": {
          "$ref": "#/$defs/Span",
          "description": "The innermost list the entry belongs to, braces included."
        },
        "prefix": {
          "$ref": "#/$defs/ModulePath",
          "description": "Combined prefix of the enclosing groups (`crate::util`)."
        },
        "statement": {
          "$ref": "#/$defs/Span",
          "description": "The enclosing statement (`pub use crate::util::{…};`)."
        },
        "top_level": {
          "description": "Whether `list` is the statement's own list rather than a nested one.",
          "type": "boolean"
        }
      },
      "required": [
        "prefix",
        "item",
        "list",
        "items",
        "statement",
        "top_level"
      ],
      "type": "object"
    },
    "Importer": {
      "description": "A file that imports from the one asked about.",
      "properties": {
        "alias": {
          "anyOf": [
            {
              "$ref": "#/$defs/Name"
            },
            {
              "type": "null"
            }
          ],
          "description": "The name the statement binds instead of the path's last segment:\n`Cfg` in `use a::Config as Cfg`."
        },
        "declares": {
          "default": true,
          "description": "Part of an import statement (`use`, `import`), so it brings its last\nsegment into the file's scope. A qualified path in an expression\n(`fff::GrepMatch` in a type position) is a reference to rewrite on a\nmove, but declares nothing.",
          "type": "boolean"
        },
        "glob": {
          "description": "`use a::b::*`: every name under the path is brought into scope.",
          "type": "boolean"
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImportGroup"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present when the path is an entry of a grouped import such as\n`use a::{b, c::d}`; replacing `span` alone can then only express\npaths that stay under the group's prefix."
        },
        "path": {
          "$ref": "#/$defs/ModulePath",
          "description": "The full path as written (`crate::a::b`, `../x/y`), parsed by the\ngrammar's [`PathSyntax`]. For a grouped entry this includes the\ngroup's prefix."
        },
        "reexport": {
          "description": "A `pub use`, an `export … from`: the name it brings in is offered on\nagain under this file's address, so a path to it here reaches the\noriginal declaration.",
          "type": "boolean"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "start": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "path",
        "span",
        "start"
      ],
      "type": "object"
    },
    "LanguageId": {
      "description": "Stable identifier of a language (`rust`, `typescript`, ...).",
      "type": "string"
    },
    "Match": {
      "properties": {
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a declaration in an addressable file: its module address, the\nvalue `outline` gives it. Filled by the engine, which has the project."
        },
        "captures": {
          "additionalProperties": {
            "$ref": "#/$defs/CaptureValue"
          },
          "type": "object"
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete source version; absent only in older serialized matches."
        },
        "end": {
          "$ref": "#/$defs/Position"
        },
        "id": {
          "$ref": "#/$defs/MatchId"
        },
        "kind": {
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/LanguageId"
        },
        "line": {
          "default": "",
          "description": "The source line on which the match starts, for display in context.",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "default": "use"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "start": {
          "$ref": "#/$defs/Position"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/Symbol"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "language",
        "span",
        "start",
        "end",
        "kind",
        "text",
        "line",
        "role"
      ],
      "type": "object"
    },
    "MatchId": {
      "description": "Content-derived identifier: the same file, range and text yield the same id\nacross runs, so a selection made from one `search` can drive a later command.",
      "type": "string"
    },
    "Modifier": {
      "description": "A visibility modifier as it appears in the source.",
      "properties": {
        "span": {
          "$ref": "#/$defs/Span"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "span",
        "text"
      ],
      "type": "object"
    },
    "ModulePath": {
      "description": "A path as spelled in source: its head and its segments, with the syntax\nthat spells it. Serialises as the text, so the wire is what the user\nwrote.",
      "type": "string"
    },
    "Name": {
      "description": "One identifier: a module, a declaration, a file stem. Compared by text.",
      "type": "string"
    },
    "OutputLimit": {
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "required_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_bytes",
        "required_bytes"
      ],
      "type": "object"
    },
    "PackageId": {
      "description": "The name a package goes by in paths: a Rust crate's lib name (`fff`, not\n`fff-search`), a TypeScript package's name. The layout decides the spelling.",
      "type": "string"
    },
    "Position": {
      "description": "Zero-based line and character column. Columns count `char`s, not bytes,\nso they are safe to show to humans and editors.",
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "type": "object"
    },
    "Recovery": {
      "description": "A recovery result; unknown states are separate from confirmed residual effects.",
      "properties": {
        "cause": {
          "$ref": "#/$defs/Failure"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/RecoveryIssue"
          },
          "type": "array"
        },
        "remaining": {
          "items": {
            "$ref": "#/$defs/RecoveryEffect"
          },
          "type": "array"
        },
        "unverified": {
          "items": {
            "$ref": "#/$defs/RecoveryUnverified"
          },
          "type": "array"
        }
      },
      "required": [
        "cause",
        "failures",
        "remaining",
        "unverified"
      ],
      "type": "object"
    },
    "RecoveryEffect": {
      "properties": {
        "expected": {
          "$ref": "#/$defs/RecoveryState"
        },
        "observed": {
          "$ref": "#/$defs/RecoveryState"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path",
        "expected",
        "observed"
      ],
      "type": "object"
    },
    "RecoveryIssue": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/RecoveryOperation"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "operation",
        "path",
        "code",
        "message"
      ],
      "type": "object"
    },
    "RecoveryOperation": {
      "enum": [
        "restore_file",
        "restore_move",
        "restore_directory",
        "remove_file",
        "remove_directory"
      ],
      "type": "string"
    },
    "RecoveryState": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "fingerprint": {
              "type": "string"
            },
            "kind": {
              "const": "file",
              "type": "string"
            },
            "spelling": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RelPath"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "directory",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "other",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RecoveryUnverified": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "expected": {
          "$ref": "#/$defs/RecoveryState"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path",
        "expected",
        "code",
        "message"
      ],
      "type": "object"
    },
    "RelPath": {
      "description": "A file's path inside the workspace, spelled the way the project does: `/`\non every platform.\n\nA workspace path is a project path — like a `mod` path or a\n`crate::a::b` address — not a path of the machine, so it carries its own\nspelling and is what goes on the wire, into a row, or into a diagnostic.\nIt reads as a [`Path`] (an OS path is made from one at the edge, where a\nfile is actually read), but it cannot spell a separator the host's way:\n`Display`, serde and the stored bytes are always `/`.",
      "type": "string"
    },
    "Role": {
      "description": "What position a match occupies in its file: the declaration itself, a\ntoken inside an import statement, or any other use. Views lead with\ndeclarations and dim imports; the engine orders results by it.",
      "enum": [
        "declaration",
        "import",
        "use"
      ],
      "type": "string"
    },
    "Skipped": {
      "description": "A language a search left out, and why: its grammar could not compile the\nquery (a Rust pattern on a TypeScript tree). Never fatal; the other\nlanguages' matches are complete. Data only; the display layer words it.",
      "properties": {
        "language": {
          "$ref": "#/$defs/LanguageId"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "language",
        "reason"
      ],
      "type": "object"
    },
    "SourceAnchor": {
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentId"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "path",
        "content",
        "span"
      ],
      "type": "object"
    },
    "Span": {
      "description": "Half-open byte range `[start, end)` inside a single file.",
      "properties": {
        "end": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Symbol": {
      "description": "A declaration found in one file.",
      "properties": {
        "extent": {
          "$ref": "#/$defs/Span",
          "description": "The declaration with what belongs to it in the text: leading\nattributes and doc comments, an enclosing `export`. What moving the\ndeclaration cuts; what an outline shows."
        },
        "kind": {
          "$ref": "#/$defs/SymbolKind"
        },
        "name": {
          "type": "string"
        },
        "name_span": {
          "$ref": "#/$defs/Span",
          "description": "The identifier token itself: what a rename replaces."
        },
        "span": {
          "$ref": "#/$defs/Span",
          "description": "The declaration node."
        },
        "visibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Modifier"
            },
            {
              "type": "null"
            }
          ],
          "description": "The visibility as written (`pub(crate)`, `export`); `None` when the\ndeclaration has no modifier. What it means is the language's\n[`Semantics`](crate::Semantics)."
