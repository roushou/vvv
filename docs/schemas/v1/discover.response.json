{
  "$defs": {
    "Address": {
      "description": "A position in a language's namespace: the package it belongs to and the\npath within it — `fff :: [grep, types]` for a Rust module, path\ncomponents for a TypeScript file. Prefix relations, which are what a move\ncares about, never hold across packages.",
      "properties": {
        "package": {
          "$ref": "#/$defs/PackageId"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/Name"
          },
          "type": "array"
        }
      },
      "required": [
        "package",
        "path"
      ],
      "type": "object"
    },
    "Capability": {
      "properties": {
        "command": {
          "type": "string"
        },
        "parameters": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "read_only": {
          "description": "Whether this command is always read-only, including every supported option.",
          "type": "boolean"
        },
        "schemas": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchemaReferences"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "command",
        "read_only",
        "parameters"
      ],
      "type": "object"
    },
    "Capture": {
      "description": "One meta-variable binding.",
      "properties": {
        "span": {
          "$ref": "#/$defs/Span"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "span",
        "text"
      ],
      "type": "object"
    },
    "CaptureValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/Capture"
        },
        {
          "items": {
            "$ref": "#/$defs/Capture"
          },
          "type": "array"
        }
      ],
      "description": "`$A` binds one node; `$$$A` binds a sequence."
    },
    "ContentId": {
      "description": "Digest of complete file contents, independent of their path.",
      "type": "string"
    },
    "ContextBudget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 16384,
          "description": "Maximum compact JSON bytes in the result, excluding the response envelope.",
          "format": "uint",
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer"
        },
        "max_files": {
          "default": 64,
          "description": "Maximum source files examined for incoming written-name and named-alias references.",
          "format": "uint",
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "max_items": {
          "default": 12,
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "max_lookups": {
          "default": 64,
          "format": "uint",
          "maximum": 512,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_bytes",
        "max_items",
        "max_lookups",
        "max_files"
      ],
      "type": "object"
    },
    "ContinuationRecovery": {
      "description": "A recovery action clients can branch on without parsing the error message.",
      "enum": [
        "restart_query",
        "correct_cursor",
        "increase_budget_or_narrow_query",
        "narrow_query"
      ],
      "type": "string"
    },
    "Discovery": {
      "properties": {
        "commands": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "type": "array"
        },
        "context_defaults": {
          "$ref": "#/$defs/ContextBudget"
        },
        "context_maximum": {
          "$ref": "#/$defs/ContextBudget"
        },
        "languages": {
          "items": {
            "$ref": "#/$defs/LanguageId"
          },
          "type": "array"
        },
        "max_output_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "min_output_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "page_defaults": {
          "$ref": "#/$defs/PageBudget"
        },
        "page_maximum": {
          "$ref": "#/$defs/PageBudget"
        },
        "plan_retention": {
          "$ref": "#/$defs/PlanLimits"
        },
        "query_retention": {
          "$ref": "#/$defs/QueryLimits"
        },
        "schema": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "schemas_available": {
          "default": false,
          "type": "boolean"
        },
        "validation_available": {
          "type": "boolean"
        },
        "validation_defaults": {
          "$ref": "#/$defs/ValidationBudget"
        },
        "work_defaults": {
          "$ref": "#/$defs/WorkBudget"
        },
        "work_maximum": {
          "$ref": "#/$defs/WorkBudget"
        }
      },
      "required": [
        "schemas_available",
        "validation_available",
        "validation_defaults",
        "schema",
        "languages",
        "commands",
        "page_defaults",
        "page_maximum",
        "work_defaults",
        "work_maximum",
        "query_retention",
        "plan_retention",
        "context_defaults",
        "context_maximum",
        "min_output_bytes",
        "max_output_bytes"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "The kind of failure, stable across releases; the message is not.",
      "oneOf": [
        {
          "enum": [
            "invalid_plan",
            "plan_expired",
            "plan_consumed",
            "cursor_expired",
            "invalid_cursor",
            "retention_limit",
            "output_limit"
          ],
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The caller cancelled the operation.",
          "type": "string"
        },
        {
          "const": "incomplete",
          "description": "Resolution stopped before a complete answer was available.",
          "type": "string"
        },
        {
          "const": "bad_request",
          "description": "The request could not be read: not JSON, or not a known command.",
          "type": "string"
        },
        {
          "const": "bad_query",
          "description": "A query with none of pattern, kind, symbol, name.",
          "type": "string"
        },
        {
          "const": "bad_pattern",
          "description": "A pattern or node kind the language's grammar rejects.",
          "type": "string"
        },
        {
          "const": "bad_selection",
          "description": "A selection naming rows or ids the search did not find.",
          "type": "string"
        },
        {
          "const": "bad_template",
          "description": "A template naming a capture the match does not have.",
          "type": "string"
        },
        {
          "const": "no_such_symbol",
          "description": "No declaration by that name (and kind).",
          "type": "string"
        },
        {
          "const": "ambiguous_symbol",
          "description": "Several declarations share the name; `declared_in` picks one.",
          "type": "string"
        },
        {
          "const": "no_language",
          "description": "No registered language claims the file.",
          "type": "string"
        },
        {
          "const": "no_layout",
          "description": "The language has no layout: paths cannot be followed, files not moved.",
          "type": "string"
        },
        {
          "const": "no_such_position",
          "description": "A position past the end of the file.",
          "type": "string"
        },
        {
          "const": "exists",
          "description": "The destination already exists.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "A file, or the file declaring a name, could not be found.",
          "type": "string"
        },
        {
          "const": "unmovable",
          "description": "The layout refuses the move: a root, across packages, into itself.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "Two edits of one plan overlap, or a file is moved twice.",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "A file changed since the plan (or the apply to undo) was made.",
          "type": "string"
        },
        {
          "const": "no_history",
          "description": "Nothing to undo, or a history file that cannot be read.",
          "type": "string"
        },
        {
          "const": "io",
          "description": "Reading or writing the tree failed.",
          "type": "string"
        },
        {
          "const": "recovery_failed",
          "description": "Recovery could not restore or verify every attempted effect.",
          "type": "string"
        }
      ]
    },
    "Failure": {
      "description": "A failed request, as the wire carries it.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContinuationRecovery"
            },
            {
              "type": "null"
            }
          ]
        },
        "hint": {
          "description": "What to try instead, when there is something.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "output_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recovery"
            },
            {
              "type": "null"
            }
          ],
          "description": "Effects that could not be restored after a failed mutation."
        },
        "symbol_move_candidates": {
          "items": {
            "$ref": "#/$defs/SymbolMoveCandidate"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "symbol_move_unsupported": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolMoveUnsupported"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "LanguageId": {
      "description": "Stable identifier of a language (`rust`, `typescript`, ...).",
      "type": "string"
    },
    "Match": {
      "properties": {
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a declaration in an addressable file: its module address, the\nvalue `outline` gives it. Filled by the engine, which has the project."
        },
        "captures": {
          "additionalProperties": {
            "$ref": "#/$defs/CaptureValue"
          },
          "type": "object"
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete source version; absent only in older serialized matches."
        },
        "end": {
          "$ref": "#/$defs/Position"
        },
        "id": {
          "$ref": "#/$defs/MatchId"
        },
        "kind": {
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/LanguageId"
        },
        "line": {
          "default": "",
          "description": "The source line on which the match starts, for display in context.",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "default": "use"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "start": {
          "$ref": "#/$defs/Position"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/Symbol"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "language",
        "span",
        "start",
        "end",
        "kind",
        "text",
        "line",
        "role"
      ],
      "type": "object"
    },
    "MatchId": {
      "description": "Content-derived identifier: the same file, range and text yield the same id\nacross runs, so a selection made from one `search` can drive a later command.",
      "type": "string"
    },
    "Modifier": {
      "description": "A visibility modifier as it appears in the source.",
      "properties": {
        "span": {
          "$ref": "#/$defs/Span"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "span",
        "text"
      ],
      "type": "object"
    },
    "Name": {
      "description": "One identifier: a module, a declaration, a file stem. Compared by text.",
      "type": "string"
    },
    "OutputLimit": {
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "required_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_bytes",
        "required_bytes"
      ],
      "type": "object"
    },
    "PackageId": {
      "description": "The name a package goes by in paths: a Rust crate's lib name (`fff`, not\n`fff-search`), a TypeScript package's name. The layout decides the spelling.",
      "type": "string"
    },
    "PageBudget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 16384,
          "format": "uint",
          "maximum": 1048576,
          "minimum": 1024,
          "type": "integer"
        },
        "max_items": {
          "default": 20,
          "format": "uint",
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_items",
        "max_bytes"
      ],
      "type": "object"
    },
    "PlanLimits": {
      "properties": {
        "lifetime_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_plan_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_plans": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_total_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_plans",
        "max_plan_bytes",
        "max_total_bytes",
        "lifetime_seconds"
      ],
      "type": "object"
    },
    "Position": {
      "description": "Zero-based line and character column. Columns count `char`s, not bytes,\nso they are safe to show to humans and editors.",
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "type": "object"
    },
    "QueryLimits": {
      "properties": {
        "lifetime_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_queries": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_query_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_total_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_queries",
        "max_query_bytes",
        "max_total_bytes",
        "lifetime_seconds"
      ],
      "type": "object"
    },
    "Recovery": {
      "description": "A recovery result; unknown states are separate from confirmed residual effects.",
      "properties": {
        "cause": {
          "$ref": "#/$defs/Failure"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/RecoveryIssue"
          },
          "type": "array"
        },
        "remaining": {
          "items": {
            "$ref": "#/$defs/RecoveryEffect"
          },
          "type": "array"
        },
        "unverified": {
          "items": {
            "$ref": "#/$defs/RecoveryUnverified"
          },
          "type": "array"
        }
      },
      "required": [
        "cause",
        "failures",
        "remaining",
        "unverified"
      ],
      "type": "object"
    },
    "RecoveryEffect": {
      "properties": {
        "expected": {
          "$ref": "#/$defs/RecoveryState"
        },
        "observed": {
          "$ref": "#/$defs/RecoveryState"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path",
        "expected",
        "observed"
      ],
      "type": "object"
    },
    "RecoveryIssue": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/RecoveryOperation"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "operation",
        "path",
        "code",
        "message"
      ],
      "type": "object"
    },
    "RecoveryOperation": {
      "enum": [
        "restore_file",
        "restore_move",
        "restore_directory",
        "remove_file",
        "remove_directory"
      ],
      "type": "string"
    },
    "RecoveryState": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "fingerprint": {
              "type": "string"
            },
            "kind": {
              "const": "file",
              "type": "string"
            },
            "spelling": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RelPath"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "directory",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "other",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RecoveryUnverified": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "expected": {
          "$ref": "#/$defs/RecoveryState"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path",
        "expected",
        "code",
        "message"
      ],
      "type": "object"
    },
    "RelPath": {
      "description": "A file's path inside the workspace, spelled the way the project does: `/`\non every platform.\n\nA workspace path is a project path — like a `mod` path or a\n`crate::a::b` address — not a path of the machine, so it carries its own\nspelling and is what goes on the wire, into a row, or into a diagnostic.\nIt reads as a [`Path`] (an OS path is made from one at the edge, where a\nfile is actually read), but it cannot spell a separator the host's way:\n`Display`, serde and the stored bytes are always `/`.",
      "type": "string"
    },
    "Role": {
      "description": "What position a match occupies in its file: the declaration itself, a\ntoken inside an import statement, or any other use. Views lead with\ndeclarations and dim imports; the engine orders results by it.",
      "enum": [
        "declaration",
        "import",
        "use"
      ],
      "type": "string"
    },
    "SchemaReferences": {
      "description": "Identifiers of bundled, locally retrievable command contracts.",
      "properties": {
        "arguments": {
          "type": "string"
        },
        "request": {
          "type": "string"
        },
        "response": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "required": [
        "arguments",
        "request",
        "result",
        "response"
      ],
      "type": "object"
    },
    "SourceAnchor": {
      "properties": {
        "content": {
          "$ref": "#/$defs/ContentId"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "path",
        "content",
        "span"
      ],
      "type": "object"
    },
    "Span": {
      "description": "Half-open byte range `[start, end)` inside a single file.",
      "properties": {
        "end": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Symbol": {
      "description": "A declaration found in one file.",
      "properties": {
        "extent": {
          "$ref": "#/$defs/Span",
          "description": "The declaration with what belongs to it in the text: leading\nattributes and doc comments, an enclosing `export`. What moving the\ndeclaration cuts; what an outline shows."
        },
        "kind": {
          "$ref": "#/$defs/SymbolKind"
        },
        "name": {
          "type": "string"
        },
        "name_span": {
          "$ref": "#/$defs/Span",
          "description": "The identifier token itself: what a rename replaces."
        },
        "span": {
          "$ref": "#/$defs/Span",
          "description": "The declaration node."
        },
        "visibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Modifier"
            },
            {
              "type": "null"
            }
          ],
          "description": "The visibility as written (`pub(crate)`, `export`); `None` when the\ndeclaration has no modifier. What it means is the language's\n[`Semantics`](crate::Semantics)."
        }
      },
      "required": [
        "kind",
        "name",
        "name_span",
        "span",
        "extent"
      ],
      "type": "object"
    },
    "SymbolKind": {
      "description": "What a declaration declares, in vocabulary shared by every language.",
      "oneOf": [
        {
          "enum": [
            "type-parameter",
            "parameter",
            "function",
            "method",
            "struct",
            "class",
            "enum",
            "variant",
            "trait",
            "interface",
            "type-alias",
            "const",
            "static",
            "variable",
            "field",
            "module",
            "macro"
          ],
          "type": "string"
        },
        {
          "const": "impl",
          "description": "An `impl` block, named after the type it is for. Not a declaration a\npath can reach; it travels with its type when the type moves.",
          "type": "string"
        }
      ]
    },
    "SymbolMoveCandidate": {
      "properties": {
        "declaration": {
          "$ref": "#/$defs/Match"
        },
        "pieces": {
          "items": {
            "$ref": "#/$defs/SymbolMovePiece"
          },
          "type": "array"
        },
        "unsupported": {
