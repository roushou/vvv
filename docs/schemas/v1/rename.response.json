{
  "$defs": {
    "Address": {
      "description": "A position in a language's namespace: the package it belongs to and the\npath within it — `fff :: [grep, types]` for a Rust module, path\ncomponents for a TypeScript file. Prefix relations, which are what a move\ncares about, never hold across packages.",
      "properties": {
        "package": {
          "$ref": "#/$defs/PackageId"
        },
        "path": {
          "items": {
            "$ref": "#/$defs/Name"
          },
          "type": "array"
        }
      },
      "required": [
        "package",
        "path"
      ],
      "type": "object"
    },
    "Capture": {
      "description": "One meta-variable binding.",
      "properties": {
        "span": {
          "$ref": "#/$defs/Span"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "span",
        "text"
      ],
      "type": "object"
    },
    "CaptureValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/Capture"
        },
        {
          "items": {
            "$ref": "#/$defs/Capture"
          },
          "type": "array"
        }
      ],
      "description": "`$A` binds one node; `$$$A` binds a sequence."
    },
    "Confidence": {
      "description": "How sure a rename is that an occurrence refers to its target declaration.",
      "oneOf": [
        {
          "const": "resolved",
          "description": "Declared, imported, or reached by a path that resolves to the target.",
          "type": "string"
        },
        {
          "const": "unresolved",
          "description": "A bare token with no evidence either way.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Resolves to a different declaration of the same name.",
          "type": "string"
        }
      ]
    },
    "ContentId": {
      "description": "Digest of the complete UTF-8 source text, independent of its path.",
      "type": "string"
    },
    "ContinuationRecovery": {
      "description": "A recovery action clients can branch on without parsing the error message.",
      "enum": [
        "restart_query",
        "correct_cursor",
        "increase_budget_or_narrow_query",
        "narrow_query"
      ],
      "type": "string"
    },
    "Diff": {
      "description": "One file's change: the unified diff text (the wire) and its hunks (the\nmodel).",
      "type": "string"
    },
    "Edit": {
      "description": "Replace the bytes at `span` with `replacement`.",
      "properties": {
        "replacement": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "span",
        "replacement"
      ],
      "type": "object"
    },
    "ErrorCode": {
      "description": "The kind of failure, stable across releases; the message is not.",
      "oneOf": [
        {
          "enum": [
            "cursor_expired",
            "invalid_cursor",
            "retention_limit",
            "output_limit"
          ],
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The caller cancelled the operation.",
          "type": "string"
        },
        {
          "const": "incomplete",
          "description": "Resolution stopped before a complete answer was available.",
          "type": "string"
        },
        {
          "const": "bad_request",
          "description": "The request could not be read: not JSON, or not a known command.",
          "type": "string"
        },
        {
          "const": "bad_query",
          "description": "A query with none of pattern, kind, symbol, name.",
          "type": "string"
        },
        {
          "const": "bad_pattern",
          "description": "A pattern or node kind the language's grammar rejects.",
          "type": "string"
        },
        {
          "const": "bad_selection",
          "description": "A selection naming rows or ids the search did not find.",
          "type": "string"
        },
        {
          "const": "bad_template",
          "description": "A template naming a capture the match does not have.",
          "type": "string"
        },
        {
          "const": "no_such_symbol",
          "description": "No declaration by that name (and kind).",
          "type": "string"
        },
        {
          "const": "ambiguous_symbol",
          "description": "Several declarations share the name; `declared_in` picks one.",
          "type": "string"
        },
        {
          "const": "no_language",
          "description": "No registered language claims the file.",
          "type": "string"
        },
        {
          "const": "no_layout",
          "description": "The language has no layout: paths cannot be followed, files not moved.",
          "type": "string"
        },
        {
          "const": "no_such_position",
          "description": "A position past the end of the file.",
          "type": "string"
        },
        {
          "const": "exists",
          "description": "The destination already exists.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "A file, or the file declaring a name, could not be found.",
          "type": "string"
        },
        {
          "const": "unmovable",
          "description": "The layout refuses the move: a root, across packages, into itself.",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "Two edits of one plan overlap, or a file is moved twice.",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "A file changed since the plan (or the apply to undo) was made.",
          "type": "string"
        },
        {
          "const": "no_history",
          "description": "Nothing to undo, or a history file that cannot be read.",
          "type": "string"
        },
        {
          "const": "io",
          "description": "Reading or writing the tree failed.",
          "type": "string"
        },
        {
          "const": "recovery_failed",
          "description": "Recovery could not restore or verify every attempted effect.",
          "type": "string"
        }
      ]
    },
    "Failure": {
      "description": "A failed request, as the wire carries it.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContinuationRecovery"
            },
            {
              "type": "null"
            }
          ]
        },
        "hint": {
          "description": "What to try instead, when there is something.",
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "output_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutputLimit"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recovery"
            },
            {
              "type": "null"
            }
          ],
          "description": "Effects that could not be restored after a failed mutation."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "FileChange": {
      "description": "One file a plan touches: its edits and the whole-file diff.",
      "properties": {
        "diff": {
          "$ref": "#/$defs/Diff"
        },
        "edits": {
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "type": "array"
        },
        "moved_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "Path after, when the file is moved."
        },
        "path": {
          "$ref": "#/$defs/RelPath",
          "description": "Path before the change."
        }
      },
      "required": [
        "path",
        "edits",
        "diff"
      ],
      "type": "object"
    },
    "LanguageId": {
      "description": "Stable identifier of a language (`rust`, `typescript`, ...).",
      "type": "string"
    },
    "Match": {
      "properties": {
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a declaration in an addressable file: its module address, the\nvalue `outline` gives it. Filled by the engine, which has the project."
        },
        "captures": {
          "additionalProperties": {
            "$ref": "#/$defs/CaptureValue"
          },
          "type": "object"
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete source version; absent only in older serialized matches."
        },
        "end": {
          "$ref": "#/$defs/Position"
        },
        "id": {
          "$ref": "#/$defs/MatchId"
        },
        "kind": {
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/LanguageId"
        },
        "line": {
          "default": "",
          "description": "The source line on which the match starts, for display in context.",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "default": "use"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "start": {
          "$ref": "#/$defs/Position"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/Symbol"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "language",
        "span",
        "start",
        "end",
        "kind",
        "text",
        "line",
        "role"
      ],
      "type": "object"
    },
    "MatchId": {
      "description": "Content-derived identifier: the same file, range and text yield the same id\nacross runs, so a selection made from one `search` can drive a later command.",
      "type": "string"
    },
    "Modifier": {
      "description": "A visibility modifier as it appears in the source.",
      "properties": {
        "span": {
          "$ref": "#/$defs/Span"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "span",
        "text"
      ],
      "type": "object"
    },
    "Name": {
      "description": "One identifier: a module, a declaration, a file stem. Compared by text.",
      "type": "string"
    },
    "Occurrence": {
      "description": "A token spelling the renamed name, with what the imports could tell.",
      "properties": {
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a declaration in an addressable file: its module address, the\nvalue `outline` gives it. Filled by the engine, which has the project."
        },
        "captures": {
          "additionalProperties": {
            "$ref": "#/$defs/CaptureValue"
          },
          "type": "object"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete source version; absent only in older serialized matches."
        },
        "end": {
          "$ref": "#/$defs/Position"
        },
        "id": {
          "$ref": "#/$defs/MatchId"
        },
        "kind": {
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/LanguageId"
        },
        "line": {
          "default": "",
          "description": "The source line on which the match starts, for display in context.",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        },
        "reason": {
          "$ref": "#/$defs/Reason",
          "default": "unresolved"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "default": "use"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "start": {
          "$ref": "#/$defs/Position"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/Symbol"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "language",
        "span",
        "start",
        "end",
        "kind",
        "text",
        "line",
        "role",
        "confidence",
        "reason"
      ],
      "type": "object"
    },
    "OutputLimit": {
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceAnchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "required_bytes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_bytes",
        "required_bytes"
      ],
      "type": "object"
    },
    "PackageId": {
      "description": "The name a package goes by in paths: a Rust crate's lib name (`fff`, not\n`fff-search`), a TypeScript package's name. The layout decides the spelling.",
      "type": "string"
    },
    "Position": {
      "description": "Zero-based line and character column. Columns count `char`s, not bytes,\nso they are safe to show to humans and editors.",
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "type": "object"
    },
    "Reason": {
      "description": "What the file's imports and paths said about an occurrence: the ground\nfor its [`Confidence`]. Views tag `?` and `✗` sections with it.",
      "oneOf": [
        {
          "const": "declaring",
          "description": "Written in the module that declares the target.",
          "type": "string"
        },
        {
          "const": "imported",
          "description": "An import resolving to the target brings the name in.",
          "type": "string"
        },
        {
          "const": "path",
          "description": "The tail of a qualified path resolving to the target.",
          "type": "string"
        },
        {
          "const": "opened",
          "description": "A glob (or whole-file) import opens the declaring module.",
          "type": "string"
        },
        {
          "const": "re-export",
          "description": "Reached through a re-export (`use vvv_core::Span` for\n`vvv_core::text::span::Span`) that vvv followed to the declaration.",
          "type": "string"
        },
        {
          "const": "oracle",
          "description": "Syntax could not place it; an oracle — a build, a language server —\nsaid it is the declaration.",
          "type": "string"
        },
        {
          "const": "unresolved",
          "description": "A bare name nothing imports, or a path whose head cannot be placed.",
          "type": "string"
        },
        {
          "const": "by-name",
          "description": "No declaration to judge against: a method or field, reached through\na type; the token merely spells the name.",
          "type": "string"
        },
        {
          "const": "other-declaration",
          "description": "Resolves to another declaration of the same name in the workspace.",
          "type": "string"
        },
        {
          "const": "external",
          "description": "Resolves into a package outside the workspace.",
          "type": "string"
        },
        {
          "const": "oracle-other",
          "description": "Syntax could not place it; an oracle said it is another declaration.",
          "type": "string"
        }
      ]
    },
    "Recovery": {
      "description": "A recovery result; unknown states are separate from confirmed residual effects.",
      "properties": {
        "cause": {
          "$ref": "#/$defs/Failure"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/RecoveryIssue"
          },
          "type": "array"
        },
        "remaining": {
          "items": {
            "$ref": "#/$defs/RecoveryEffect"
          },
          "type": "array"
        },
        "unverified": {
          "items": {
            "$ref": "#/$defs/RecoveryUnverified"
          },
          "type": "array"
        }
      },
      "required": [
        "cause",
        "failures",
        "remaining",
        "unverified"
      ],
      "type": "object"
    },
    "RecoveryEffect": {
      "properties": {
        "expected": {
          "$ref": "#/$defs/RecoveryState"
        },
        "observed": {
          "$ref": "#/$defs/RecoveryState"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path",
        "expected",
        "observed"
      ],
      "type": "object"
    },
    "RecoveryIssue": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/RecoveryOperation"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "operation",
        "path",
        "code",
        "message"
      ],
      "type": "object"
    },
    "RecoveryOperation": {
      "enum": [
        "restore_file",
        "restore_move",
        "restore_directory",
        "remove_file",
        "remove_directory"
      ],
      "type": "string"
    },
    "RecoveryState": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "fingerprint": {
              "type": "string"
            },
            "kind": {
              "const": "file",
              "type": "string"
            },
            "spelling": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RelPath"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "directory",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "other",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RecoveryUnverified": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "expected": {
          "$ref": "#/$defs/RecoveryState"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/RelPath"
        }
      },
      "required": [
        "path",
        "expected",
        "code",
        "message"
      ],
      "type": "object"
    },
    "RelPath": {
      "description": "A file's path inside the workspace, spelled the way the project does: `/`\non every platform.\n\nA workspace path is a project path — like a `mod` path or a\n`crate::a::b` address — not a path of the machine, so it carries its own\nspelling and is what goes on the wire, into a row, or into a diagnostic.\nIt reads as a [`Path`] (an OS path is made from one at the edge, where a\nfile is actually read), but it cannot spell a separator the host's way:\n`Display`, serde and the stored bytes are always `/`.",
      "type": "string"
    },
    "Rename": {
      "description": "`vvv rename`: the declaration and every occurrence, each judged.",
      "oneOf": [
        {
          "properties": {
            "applied": {
              "const": false
            },
            "history_id": false
          },
          "required": [
            "applied"
          ]
        },
        {
          "properties": {
            "applied": {
              "const": true
            },
            "history_id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "applied",
            "history_id"
          ]
        }
      ],
      "properties": {
        "declarations": {
          "description": "Where `name` is declared; more than one means the rename is ambiguous.",
          "items": {
            "$ref": "#/$defs/Match"
          },
          "type": "array"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        },
        "intent": {
          "$ref": "#/$defs/RenameIntent"
        },
        "occurrences": {
          "description": "Every identifier spelling the name, each judged against the target;\ntheir ids feed a later `--select`.",
          "items": {
            "$ref": "#/$defs/Occurrence"
          },
          "type": "array"
        }
      },
      "required": [
        "intent",
        "declarations",
        "occurrences",
        "files"
      ],
      "type": "object"
    },
    "RenameIntent": {
      "description": "Rename the declaration(s) called `name` and every identifier that spells it.\n\nResolution is syntactic: every occurrence of the identifier in files of\nthe declaring language is an occurrence. The `selection` is how a human or\nagent excludes the ones that are not the same symbol.",
      "properties": {
        "declared_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelPath"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file declaring the symbol meant, when several share the name."
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/LanguageId"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "to"
      ],
      "type": "object"
    },
    "Role": {
      "description": "What position a match occupies in its file: the declaration itself, a\ntoken inside an import statement, or any other use. Views lead with\ndeclarations and dim imports; the engine orders results by it.",
      "enum": [
        "declaration",
        "import",
        "use"
      ],
      "type": "string"
    },
    "Selection": {
      "description": "Which matches of a search a later command acts on.\n\nIds are content-derived, so a selection made from `vvv search` can be\nhanded to `vvv rewrite` in a separate process. Ordinals are the 1-based\npositions in the same search's result order, which is what human output\nnumbers rows with. Either kind that no longer resolves means the files\nchanged in between; the selection is then refused rather than silently\nnarrowed.",
      "oneOf": [
        {
          "enum": [
            "all"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ids": {
              "items": {
                "$ref": "#/$defs/MatchId"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "ids"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ordinals": {
              "items": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "ordinals"
          ],
          "type": "object"
        }
      ]
    },
