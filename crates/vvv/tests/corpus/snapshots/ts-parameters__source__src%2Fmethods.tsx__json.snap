  "text": "import { seed } from './origin';\nexport class View {\n  render({ title: heading = seed, details: [first, ...rest] }, later = heading) {\n    return <section>{heading}{first}{rest}{later}</section>;\n  }\n  nested([...[tail]]) {\n    return tail;\n  }\n}\n"
