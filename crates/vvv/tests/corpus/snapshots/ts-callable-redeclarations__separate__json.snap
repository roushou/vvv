      "source": {
        "path": "src/scopes.ts",
        "text": "export function shared(value) {\n  value;\n  var value;\n  return value;\n}\nexport function separate(value = 1) {\n  var value;\n  return value;\n}\nexport function combined(value) {\n  var value;\n  function value() { return 1; }\n  return value;\n}\nexport function lexical(seed) {\n  var value;\n  let value;\n  return seed;\n}\nexport function pattern({ value }) {\n  var value;\n  return value;\n}\nexport function patternDefault({ value = 1 }) {\n  var value;\n  return value;\n}\nexport function functions(value) {\n  function value() { return 1; }\n  return value;\n}\n",
